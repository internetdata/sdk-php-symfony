{
    "name": "internetdata/symfony",
    "description": "Official Symfony bundle for the InternetData API. Look up the visitor behind every request: location, network, VPN, proxy, Tor and hosting.",
    "keywords": ["symfony", "bundle", "internetdata", "ip-geolocation", "ip-intelligence", "ip-lookup", "geoblocking", "vpn-detection", "proxy-detection", "tor", "hosting", "asn"],
    "homepage": "https://internetdata.io",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "internetdata/internetdata": "^2.13.3",
        "symfony/cache": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-kernel": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-foundation": "^6.4 || ^7.0 || ^8.0",
        "symfony/config": "^6.4 || ^7.0 || ^8.0",
        "symfony/dependency-injection": "^6.4 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.11",
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0",
        "symfony/event-dispatcher": "^7.0 || ^8.0"
    },
    "autoload": { "psr-4": { "InternetData\\Symfony\\": "src/" } },
    "autoload-dev": { "psr-4": { "InternetData\\Symfony\\Tests\\": "tests/" } },
    "config": { "sort-packages": true },
    "minimum-stability": "stable",
    "prefer-stable": true
}
